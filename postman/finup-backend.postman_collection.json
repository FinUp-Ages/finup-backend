                  "pm.test(\"Status 200\", function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test(\"registrou a transacao\", function () { const b = pm.response.json(); pm.expect(b.action).to.eql(\"REGISTER_TRANSACTION\"); pm.expect(b.transaction.type).to.eql(\"EXPENSE\"); pm.expect(Number(b.transaction.amount)).to.eql(7); });",
                  "pm.test(\"devolve o id da conversa (historico)\", function () { pm.expect(pm.response.json().conversationId).to.be.a(\"string\"); }); const cid = pm.response.json().conversationId; if (cid) { pm.collectionVariables.set(\"conversationId\", cid); }"
