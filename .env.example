# Spring Boot nao le .env nativamente. Quem consome este arquivo sao dois caminhos diferentes:
# o docker-compose, que interpola os ${...} do docker-compose.yml, e o proprio Boot, via
# spring.config.import no application.yml (usado ao rodar `./mvnw spring-boot:run`).
# Dentro do container, so chegam as variaveis listadas em `environment:` no docker-compose.yml.

SERVER_PORT=8080
# Sem um usuario no Cognito, use dev,mock-auth: a identidade vem dos headers X-Mock-Cognito-*.
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# Origens permitidas no CORS, separadas por virgula (painel Vite em dev; porta 8081
# e o Expo Web, usado so como fallback de teste manual do cadastro no navegador).
# O default do application.yml e so http://localhost:5173; o 8081 vem daqui.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# PostgreSQL
DB_NAME=finup
DB_USER=finup_user
DB_PASSWORD=change_me
DB_PORT=5432
# Host do banco. Rodando a API fora do Docker, mantenha localhost; no docker-compose
# o servico "app" sobrescreve para "db" (nome do servico do Postgres na mesma rede).
DB_HOST=localhost

# AWS Cognito (console > Cognito > User pools). Nao sao segredos, mas mudam por ambiente.
# Obrigatorios fora do profile mock-auth: sem eles a aplicacao nao sobe (nem via ./mvnw,
# nem no container do docker-compose, que entra em loop de restart).
# ID do grupo de usuarios: pagina Visao geral do pool, formato <regiao>_<id>, ex.: us-east-2_AbCdEf123
COGNITO_USER_POOL_ID=
# ID do cliente: Clientes da aplicacao > FinUp. O cliente nao pode ter segredo.
COGNITO_CLIENT_ID=
