# Spring Boot nao le .env nativamente. Este arquivo alimenta o docker-compose (env_file) e
# serve de referencia das variaveis que a aplicacao espera. Rodando via `./mvnw spring-boot:run`,
# exporte as variaveis no shell ou use o profile dev, que ja tem defaults.

SERVER_PORT=8080
# Sem um usuario no Cognito, use dev,mock-auth: a identidade vem dos headers X-Mock-Cognito-*.
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# Origens permitidas no CORS, separadas por virgula (painel Vite em dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DB_NAME=finup
DB_USER=finup_user
DB_PASSWORD=change_me
DB_PORT=5432

# AWS Cognito (console > Cognito > User pools). Nao sao segredos, mas mudam por ambiente.
# ID do grupo de usuarios: pagina Visao geral do pool, formato <regiao>_<id>, ex.: us-east-2_AbCdEf123
COGNITO_USER_POOL_ID=
# ID do cliente: Clientes da aplicacao > FinUp. O cliente nao pode ter segredo.
COGNITO_CLIENT_ID=
