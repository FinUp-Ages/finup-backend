# Spring Boot nao le .env nativamente. Este arquivo alimenta o docker-compose (env_file) e
# serve de referencia das variaveis que a aplicacao espera. Rodando via `./mvnw spring-boot:run`,
# exporte as variaveis no shell ou use o profile dev, que ja tem defaults.

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# Origens permitidas no CORS, separadas por virgula (painel Vite em dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173
